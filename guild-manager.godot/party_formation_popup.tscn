[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/PartyFormationPopup.cs" id="1_script"]

[node name="PartyFormationPopup" type="PopupPanel"]
title = "パーティー編成"
initial_position = 1
size = Vector2i(720, 560)
script = ExtResource("1_script")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 8.0
offset_top = 8.0
offset_right = -8.0
offset_bottom = -8.0
grow_horizontal = 2
grow_vertical = 2

[node name="TitleLabel" type="Label" parent="VBox"]
custom_minimum_size = Vector2(700, 0)
layout_mode = 2
text = "パーティー編成：1人は同時に1つのパーティーにしか所属できない。険悪なペア（相性30未満）は赤字で警告表示されるが、編成自体は妨げない。"
autowrap_mode = 2

[node name="PartyRow" type="HBoxContainer" parent="VBox"]
layout_mode = 2
size_flags_vertical = 3

