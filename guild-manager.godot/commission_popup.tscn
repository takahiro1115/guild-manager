[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/CommissionPopup.cs" id="1_script"]
[ext_resource type="Theme" path="res://themes/dungeon_theme.tres" id="2_theme"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_popup"]
bg_color = Color(0.1, 0.1, 0.12, 1)
