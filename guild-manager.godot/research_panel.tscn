[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/UI/ResearchPanel.cs" id="1_script"]

[node name="ResearchPanel" type="ScrollContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
horizontal_scroll_mode = 0
script = ExtResource("1_script")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="TitleLabel" type="Label" parent="VBox"]
layout_mode = 2
text = "アルベールの研究室：採取した素材と資金を投じて、恒久的なインフラ強化を研究する。"
autowrap_mode = 2

[node name="ResourcesLabel" type="RichTextLabel" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
bbcode_enabled = true
fit_content = true

[node name="Separator1" type="HSeparator" parent="VBox"]
layout_mode = 2

[node name="ResearchCards" type="VBoxContainer" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
