[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/UI/FacilityPanel.cs" id="1_script"]

[node name="FacilityPanel" type="VBoxContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
